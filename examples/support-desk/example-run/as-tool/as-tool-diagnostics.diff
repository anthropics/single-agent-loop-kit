+def response_problems(result) -> list[str]:
+    """Why a subagent's result does not fit the response schema. Empty when it fits."""
+    if not isinstance(result, dict):
+        return ["not a JSON object"]
+    fields = RESPONSE_SCHEMA["properties"]
+    problems = [f"missing {key}" for key in RESPONSE_SCHEMA["required"] if key not in result]
+    problems += [f"unexpected {key}" for key in result if key not in fields]
+    for key, spec in fields.items():
+        if key not in result:
+            continue
+        value = result[key]
+        if spec["type"] == "array":
+            fits = isinstance(value, list) and all(isinstance(item, str) for item in value)
+        else:
+            fits = isinstance(value, str) and value in spec.get("enum", [value])
+        if not fits:
+            problems.append(f"bad {key}")
+    if isinstance(result.get("conclusion"), str) and not result["conclusion"].strip():
+        problems.append("empty conclusion")
+    return problems
+
+
+def _json_object(text: str):
+    start, end = text.find("{"), text.rfind("}")   # tolerates a code fence around the object
+    try:
+        return json.loads(text[start:end + 1])
+    except ValueError:
+        return None
+
+
+def run_subagent_as_tool(rt: Runtime, name: str, brief: str) -> str:
+    """Run one specialist in a fresh context and return its result as checked JSON."""
+    system = f"{load_prompt(name)}\n\n{load_prompt('subagent_response')}"
+    text = run_subagent(rt, name, brief, system=system)
+    result = _json_object(text)
+    problems = response_problems(result)
+    if not problems:
+        return json.dumps(result)
+    if not text.strip():
+        return json.dumps({"error": f"The {name} subagent returned nothing."})
+    # Keep what it said, but never as if it were a checked answer.
+    said = result.get("conclusion") if isinstance(result, dict) else None
+    return json.dumps({
+        "conclusion": said.strip() if isinstance(said, str) and said.strip() else text.strip(),
+        "evidence": [],
+        "actions_taken": [],
+        "confidence": "low",
+        "caveats": [f"The {name} result did not fit the agreed format ({'; '.join(problems)}), "
+                    "so it has not been checked. Treat it as unverified."],
+    })
+
+
