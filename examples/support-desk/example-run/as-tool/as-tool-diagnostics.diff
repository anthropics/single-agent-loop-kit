diff --git a/tests/test_diagnose_device.py b/tests/test_diagnose_device.py
new file mode 100644
index 0000000..9bd5a64
--- /dev/null
+++ b/tests/test_diagnose_device.py
@@ -0,0 +1,107 @@
+"""diagnose_device with no model in the loop: the two failure paths, and the happy path
+end to end through the router with a scripted client.
+
+    python3 -m unittest discover tests
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+from app.backend import Backend  # noqa: E402
+from app.llm import Meter  # noqa: E402
+from app.orchestrator import Conversation, diagnose_device  # noqa: E402
+from app.subagents import Runtime, response_problems  # noqa: E402
+
+GOOD = {"conclusion": "E42, a brush motor stall. Clear the brush roll and reseat it.",
+        "evidence": ["E42 on 5 ERR lines", "lookup_error_code(E42): Brush motor stall"],
+        "actions_taken": [], "confidence": "high", "caveats": []}
+
+
+def _text(text):
+    return SimpleNamespace(content=[SimpleNamespace(type="text", text=text)], stop_reason="end_turn",
+                           usage=SimpleNamespace(input_tokens=1, output_tokens=1))
+
+
+def _use(name, args):
+    block = SimpleNamespace(type="tool_use", id=f"toolu_{name}", name=name, input=args)
+    return SimpleNamespace(content=[block], stop_reason="tool_use",
+                           usage=SimpleNamespace(input_tokens=1, output_tokens=1))
+
+
+class Scripted:
+    """Hands back the given responses in order and keeps every request it was sent."""
+
+    def __init__(self, *responses):
+        self.messages, self.responses, self.requests = self, list(responses), []
+
+    def create(self, **request):
+        self.requests.append(request)
+        return self.responses.pop(0)
+
+
+def _runtime(*responses):
+    return Runtime(Backend(), Meter(), Scripted(*responses))
+
+
+@mock.patch.dict("os.environ", {"KIT_MODEL": "fake"})
+class DiagnoseDevice(unittest.TestCase):
+    def test_missing_serial_is_refused_before_any_model_call(self):
+        for args in ({"question": "It blinks red."}, {"serial": "  ", "question": "It blinks red."}):
+            rt = _runtime()
+            result = json.loads(diagnose_device(rt, args))
+            self.assertIn("serial number", result["error"])
+            self.assertEqual(rt.client.requests, [])
+
+    def test_result_that_does_not_fit_comes_back_flagged(self):
+        missing_field = {k: v for k, v in GOOD.items() if k != "caveats"}
+        for reply in ("It is E42. Clean the brush roll.", json.dumps(missing_field),
+                      json.dumps({**GOOD, "confidence": "certain"}), json.dumps({**GOOD, "extra": 1})):
+            result = json.loads(diagnose_device(_runtime(_text(reply)), {"serial": "SN-VAC-3391", "question": "?"}))
+            self.assertEqual(response_problems(result), [])
+            self.assertEqual(result["confidence"], "low")
+            self.assertIn("did not fit the agreed format", result["caveats"][0])
+
+    def test_empty_result_is_an_error(self):
+        result = json.loads(diagnose_device(_runtime(_text("")), {"serial": "SN-VAC-3391", "question": "?"}))
+        self.assertIn("returned nothing", result["error"])
+
+    def test_fitting_result_passes_through_and_the_brief_carries_the_serial(self):
+        rt = _runtime(_text("```json\n" + json.dumps(GOOD) + "\n```"))
+        result = json.loads(diagnose_device(rt, {"serial": "SN-VAC-3391", "question": "It stops and blinks red."}))
+        self.assertEqual(result, GOOD)
+        request = rt.client.requests[0]
+        self.assertIn("SN-VAC-3391", request["messages"][0]["content"])
+        self.assertIn("It stops and blinks red.", request["messages"][0]["content"])
+        self.assertIn('"conclusion"', request["system"])
+        self.assertEqual({t["name"] for t in request["tools"]}, {"fetch_device_logs", "lookup_error_code"})
+
+    def test_router_reaches_diagnostics_through_the_tool(self):
+        client = Scripted(
+            _use("diagnose_device", {"serial": "SN-VAC-3391", "question": "Stops and blinks red."}),  # router
+            _use("fetch_device_logs", {"serial": "SN-VAC-3391"}),                                     # diagnostics
+            _use("lookup_error_code", {"code": "E42"}),
+            _text(json.dumps(GOOD)),
+            _text("It is error E42. Clear the brush roll."),                                          # router
+        )
+        conversation = Conversation(Backend(), Meter(), client)
+        reply = conversation.send("My vacuum SN-VAC-3391 stops and blinks red.")
+        self.assertEqual(reply, "It is error E42. Clear the brush roll.")
+        self.assertEqual(conversation.rt.meter.by_agent["diagnostics"]["calls"], 3)
+        results = [m for m in client.requests[-1]["messages"] if m["role"] == "user" and isinstance(m["content"], list)]
+        handed_back = results[-1]["content"][0]["content"]
+        self.assertEqual(json.loads(handed_back), GOOD)
+        self.assertNotIn("INFO", handed_back)   # the log stays in the subagent's context
+        delegate = next(t for t in client.requests[0]["tools"] if t["name"] == "delegate")
+        self.assertNotIn("diagnostics", delegate["input_schema"]["properties"]["agent"]["enum"])
+
+
+if __name__ == "__main__":
+    unittest.main()
